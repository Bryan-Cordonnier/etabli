{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Etabli",
  "version": "0.1.2",
  "identifier": "fr.etabli.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Établi",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "apercu",
        "create": false,
        "title": "Aperçu rapide — Établi",
        "url": "apercu.html",
        "width": 1280,
        "height": 800,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src http://plugins.localhost plugins:",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDOTVBMzg4RUYzNDJBNEYKUldSUEtqVHZpS09WL0kvV2JadXpYSUpoQTVqM3dLTUxuOWZCanpZWitPckRUWXpqTnROR0RXazQK",
      "endpoints": ["https://github.com/Bryan-Cordonnier/etabli/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "publisher": "Bryan Cordonnier",
    "copyright": "© 2026 Bryan Cordonnier, licence MIT",
    "license": "MIT",
    "homepage": "https://github.com/Bryan-Cordonnier/etabli",
    "shortDescription": "Boîte à outils de chaudronnerie",
    "resources": {
      "plugins-officiels/": "plugins/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "windows/installateur.wxs",
        "language": "fr-FR",
        "upgradeCode": "1F476224-4618-46A0-A1FC-3EF01D47C8F3"
      }
    }
  }
}
