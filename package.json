{
  "name": "etabli",
  "private": true,
  "description": "Boîte à outils de bureau extensible par plugins, pour la chaudronnerie (BTS CRCI)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "npm run tauri dev -w @etabli/desktop",
    "build": "npm run tauri build -w @etabli/desktop",
    "check": "npm run check --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
