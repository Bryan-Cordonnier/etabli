{
  "name": "etabli",
  "private": true,
  "description": "Boîte à outils de bureau extensible par plugins, pour la chaudronnerie (BTS CRCI)",
  "license": "MIT",
  "author": "Bryan Cordonnier",
  "homepage": "https://github.com/Bryan-Cordonnier/etabli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bryan-Cordonnier/etabli.git"
  },
  "bugs": {
    "url": "https://github.com/Bryan-Cordonnier/etabli/issues"
  },
  "keywords": [
    "chaudronnerie",
    "tôlerie",
    "atelier",
    "calculs",
    "plugins",
    "tauri",
    "svelte"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "npm run build:plugins && npm run tauri dev -w @etabli/desktop",
    "build": "npm run build:plugins && npm run tauri build -w @etabli/desktop",
    "build:plugins": "npm run build -w plugins --if-present",
    "version:app": "node scripts/version.mjs",
    "paquet": "node scripts/paquet-plugin.mjs",
    "nouveau-plugin": "node scripts/nouveau-plugin.mjs",
    "valider": "node scripts/valider-plugin.mjs",
    "liens": "node scripts/verifier-liens.mjs",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "build:web": "npm run build:plugins && npm run build:web -w @etabli/desktop && node scripts/construire-web.mjs",
    "preview:web": "node scripts/servir-web.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "yaml": "^2.9.1"
  }
}
