{
  "name": "@etabli/ui",
  "version": "0.1.0",
  "description": "Kit d'interface des mini-apps Établi : champs numériques, résultats copiables, cartes, sélecteurs, et outils sans interface (argent en centimes, dates civiles).",
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./money": {
      "types": "./src/money.ts",
      "default": "./src/money.ts"
    },
    "./civil": {
      "types": "./src/civil.ts",
      "default": "./src/civil.ts"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@etabli/sdk": "*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
